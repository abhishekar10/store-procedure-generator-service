# Copy to .env for local development. .env is gitignored -- never commit a real key.
# In AWS the key comes from Secrets Manager and is injected into the task; there
# is no .env file in the container.

# --- required ---------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- optional: everything below has a working default ------------------------

# Browser origins allowed by CORS, comma separated. Empty means none, which is
# correct for a service behind a gateway. Set this only for a browser client.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# Model IDs. Floating aliases on purpose -- gemini-2.0-flash and
# text-embedding-004 both returned 404 on this key.
# GENERATION_MODEL=models/gemini-flash-latest
# EMBEDDING_MODEL=models/gemini-embedding-001

# How long the generation model reasons before answering: auto | low | medium | high.
# low takes ~15s per generation; auto (the model's own default) took 39-162s.
# If the model rejects the level, generation falls back to auto rather than failing.
# GENERATION_THINKING_LEVEL=low
# The same for the request classifier; low gave the same answers as auto, ~1.5s faster.
# CLASSIFIER_THINKING_LEVEL=low

# Number of schema chunks pulled per request (pattern chunks are always all 7).
# RETRIEVAL_TOP_K=5

# Upstream timeouts (seconds) and attempts (including the first call).
# Generation is measured at 44-232s, so its timeout sits above that.
# CLASSIFIER_TIMEOUT_S=20
# EMBEDDING_TIMEOUT_S=20
# GENERATION_TIMEOUT_S=300
# CLASSIFIER_ATTEMPTS=3
# EMBEDDING_ATTEMPTS=3
# GENERATION_ATTEMPTS=2
# GENERATION_RETRY_WINDOW_S=30   # never retry an attempt that ran longer than this
# GENERATION_RETRY_BACKOFF_S=2

# Request limits.
# MAX_PROMPT_CHARS=8000
# MAX_REQUEST_BYTES=65536

# In-process rate limit on the generation endpoints (a fallback; the real
# limit belongs at the ALB/WAF or gateway). Set TRUST_FORWARDED_FOR=true only
# behind a proxy that sets X-Forwarded-For.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=6
# RATE_LIMIT_BURST=3
# TRUST_FORWARDED_FOR=false

# SSE keepalive interval while the model is thinking.
# SSE_HEARTBEAT_S=15

# LOG_LEVEL=INFO

# Paths. Defaults sit under backend/; the container overrides none of these.
# REFERENCE_DB_PATH=backend/db/reference.db
# SCHEMA_METADATA_PATH=backend/db/metadata.json
# VECTOR_STORE_DIR=backend/data/vector_store
# DATA_DIR=backend/data
