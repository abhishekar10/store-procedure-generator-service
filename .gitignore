# Generated/derived, rebuildable via build_db.py and app/rag/ingest.py
backend/db/reference.db
backend/data/

__pycache__/
*.pyc

# Secrets and local virtualenvs (these rules lived in the parent rag/.gitignore,
# which did not travel with the subtree split).
.env
.venv/

# Terraform: local state holds resource IDs (and the origin-verify header);
# tfvars hold the owner's email. Lock files ARE committed.
infra/**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
infra/**/terraform.tfvars
infra/**/.build/
