# Copy to .env for local development. .env is gitignored -- never commit a real key.
# In AWS the key comes from Secrets Manager and is injected into the task; there
# is no .env file in the container.

# --- required ---------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- optional: everything below has a working default ------------------------

# Browser origins allowed by CORS, comma separated. Empty means none, which is
# correct for a service behind a gateway. Set this only for a browser client.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# Model IDs. Floating aliases on purpose -- gemini-2.0-flash and
# text-embedding-004 both returned 404 on this key.
# GENERATION_MODEL=models/gemini-flash-latest
# EMBEDDING_MODEL=models/gemini-embedding-001

# Number of schema chunks pulled per request (pattern chunks are always all 6).
# RETRIEVAL_TOP_K=5

# Paths. Defaults sit under backend/; the container overrides none of these.
# REFERENCE_DB_PATH=backend/db/reference.db
# SCHEMA_METADATA_PATH=backend/db/metadata.json
# VECTOR_STORE_DIR=backend/data/vector_store
# DATA_DIR=backend/data
